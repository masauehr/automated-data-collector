# Bluesky 投稿用の認証情報サンプル（ダミー値）
# 使い方:
#   cp ~/.openclaw/bsky.env.example ~/.openclaw/bsky.env
#   （bsky.env を編集して実際の値を記入）
#   chmod 600 ~/.openclaw/bsky.env
#
# ハンドル: Bluesky のプロフィールに表示されるもの（@は付けない）
BSKY_HANDLE=example.bsky.social
# アプリパスワード: Bluesky 設定 → プライバシーとセキュリティ → アプリパスワード で発行
# （メインのログインパスワードは使わない。形式は xxxx-xxxx-xxxx-xxxx）
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
